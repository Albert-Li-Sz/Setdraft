# Setdraft deployment configuration. install/start/upgrade persist these settings to .env.
# Command flags > process environment > .env. Never commit .env or source it as shell code.
SETDRAFT_WORKSPACE_ROOT=".setdraft"

# Web/API listen on all IPv4 interfaces by default. Use 127.0.0.1 for a same-host proxy only.
SETDRAFT_HOST="0.0.0.0"
# Docker Compose port (native development keeps port 4321).
SETDRAFT_PORT="4321"
# Empty: direct HTTP access through server IP:4321. With your own proxy, set the exact
# browser origin, e.g. https://setdraft.example.com (no trailing slash).
SETDRAFT_PUBLIC_ORIGIN=""

# Official prebuilt release images (Linux amd64 / arm64). Installer defaults to pulling.
# Use ./install.sh --build for source builds; --prebuilt switches back. Mode is persisted.
SETDRAFT_IMAGE_MODE="prebuilt"
# Trusted GHCR mirror/namespace may be used if it contains all three Setdraft images.
SETDRAFT_IMAGE_NAMESPACE="ghcr.io/albert-li-sz"
# latest follows tested stable main/release builds; use 1.8.1 or Rev1.8.1 to pin a version.
SETDRAFT_IMAGE_TAG="latest"
# Optional full image references (tag or @sha256:digest); override namespace/tag.
SETDRAFT_WEB_IMAGE=""
SETDRAFT_MAINTENANCE_IMAGE=""

# Source builds only: cn uses npmmirror + Tsinghua Debian mirror. global: npmjs + deb.debian.org.
# Empty custom values follow the profile; explicit values always override it.
SETDRAFT_NETWORK="cn"
SETDRAFT_NPM_REGISTRY=""
SETDRAFT_DEBIAN_MIRROR=""
# Optional trusted Docker Hub mirror host[/namespace], WITHOUT https:// or /library.
# Node, PostgreSQL, Python and GCC use this mirror; pinned digests are retained.
SETDRAFT_DOCKER_REGISTRY=""
# Optional HTTP(S) build download proxy. Use an address reachable from containers. Does not configure Docker's daemon.
SETDRAFT_DOWNLOAD_PROXY=""

# Compose generates separate PostgreSQL and search secrets in .env.compose (mode 0600).
# Do not publish PostgreSQL or SearXNG ports. Compose configures their internal URLs.
# Optional trusted SearXNG image mirror, retaining the image digest from compose.yaml.
SETDRAFT_SEARCH_IMAGE=""
# Optional HTTP(S) proxy used only by SearXNG outbound requests.
SETDRAFT_SEARCH_PROXY=""
# Search DNS: empty refreshes from host resolvers on install/upgrade/start.
# Concrete addresses are persisted in .env.compose for container restarts.
# If the host has only loopback/empty DNS: cn uses AliDNS, global uses Cloudflare.
# Use container-reachable DNS IPs for a private network; never 127.0.0.1/::1.
SETDRAFT_SEARCH_DNS_PRIMARY=""
SETDRAFT_SEARCH_DNS_SECONDARY=""
# Native development only: restricted PostgreSQL role (never a superuser), and SearXNG URL.
# Initialize schemas first with SETDRAFT_DATABASE_ADMIN_URL and npm run db:migrate --workspace=@setdraft/server.
SETDRAFT_DATABASE_URL=""
SETDRAFT_SEARCH_URL=""

# Optional full sandbox image reference; empty follows namespace/tag in Compose.
SETDRAFT_SANDBOX_IMAGE=""
# Optional application limits; empty = server default.
SETDRAFT_TESTCASES_MAX=""
SETDRAFT_TOTAL_TIME_LIMIT_MS=""
SETDRAFT_CASE_MAX_BYTES=""
SETDRAFT_PROJECT_MAX_BYTES=""
SETDRAFT_AI_CONFIG_PATH=""

# Sandbox scheduling; empty uses these defaults. Each user runs at most one task.
# Each running sandbox can use 1 CPU / 2 GiB; leave resources for Web, PostgreSQL and search.
SETDRAFT_SANDBOX_CONCURRENCY="2"
# Admission limits include queued AND running tasks.
SETDRAFT_SANDBOX_MAX_OUTSTANDING="64"
SETDRAFT_SANDBOX_MAX_OUTSTANDING_PER_USER="8"
SETDRAFT_SANDBOX_QUEUE_TIMEOUT_MS="1800000"
SETDRAFT_SANDBOX_RUN_TIMEOUT_MS="900000"
SETDRAFT_SANDBOX_BUILD_TIMEOUT_MS="1800000"

# Optional server observability; no collector is needed while disabled.
# For Compose, use a collector hostname/address reachable from the web container.
# See docs/observability.md for all supported signal-specific overrides.
SETDRAFT_OTEL_ENABLED="0"
OTEL_SERVICE_NAME="setdraft"
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_TRACES_SAMPLER="parentbased_traceidratio"
OTEL_TRACES_SAMPLER_ARG="0.1"
