# Setdraft deployment configuration. install/start/upgrade persist these settings to .env.
# Command flags > process environment > .env. Never commit .env or source it as shell code.
HYDRO_WORKSPACE_ROOT=".hydro-problem-make"

# Local: off + empty origin. Managed proxy: caddy + http://your.domain or http://your.ip.
# Domains may opt into HTTPS with uploaded certificate/key files below. IPv6 URLs need brackets.
# Existing same-host Caddy/nginx: external + the exact HTTP(S) origin.
HYDRO_PROXY_MODE="off"
HYDRO_PUBLIC_ORIGIN=""
# For HTTPS domains only: PEM full certificate chain and matching unencrypted PEM private key.
# The installer validates and copies them into deployment/tls, then saves the managed paths here.
HYDRO_SSL_CERT=""
HYDRO_SSL_KEY=""

# cn: npmmirror + Tsinghua Debian mirror. global: npmjs + deb.debian.org.
# Empty custom values follow the profile; explicit values always override it.
HYDRO_NETWORK="cn"
HYDRO_NPM_REGISTRY=""
HYDRO_DEBIAN_MIRROR=""
# Optional trusted Docker Hub mirror host[/namespace], WITHOUT https:// or /library.
# Both Python and GCC are fetched via <host>/library/<image>; GCC keeps its pinned digest.
HYDRO_DOCKER_REGISTRY=""
# Optional HTTP(S) proxy for npm, Git, Caddy downloads. Does not configure Docker's daemon.
HYDRO_DOWNLOAD_PROXY=""
# Optional HTTPS directory containing the official Caddy release archives (filename appended).
HYDRO_CADDY_DOWNLOAD_BASE=""
# Optional local official release archive, or an existing Caddy 2 executable (absolute path recommended).
HYDRO_CADDY_ARCHIVE=""
HYDRO_CADDY_BIN=""

# Optional application limits; empty = server default.
HYDRO_SANDBOX_IMAGE=""
HYDRO_TESTCASES_MAX=""
HYDRO_TOTAL_TIME_LIMIT_MS=""
HYDRO_CASE_MAX_BYTES=""
HYDRO_PROJECT_MAX_BYTES=""
HYDRO_AI_CONFIG_PATH=""
