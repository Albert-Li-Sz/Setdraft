# Setdraft deployment configuration. install/start/upgrade persist these settings to .env.
# Command flags > process environment > .env. Never commit .env or source it as shell code.
SETDRAFT_WORKSPACE_ROOT=".setdraft"

# Web/API listen on all IPv4 interfaces by default. Use 127.0.0.1 for a same-host proxy only.
SETDRAFT_HOST="0.0.0.0"
# Docker Compose port (native development keeps port 4321).
SETDRAFT_PORT="4321"
# Empty: direct HTTP access through server IP:4321. With your own proxy, set the exact
# browser origin, e.g. https://setdraft.example.com (no trailing slash).
SETDRAFT_PUBLIC_ORIGIN=""

# cn: npmmirror + Tsinghua Debian mirror. global: npmjs + deb.debian.org.
# Empty custom values follow the profile; explicit values always override it.
SETDRAFT_NETWORK="cn"
SETDRAFT_NPM_REGISTRY=""
SETDRAFT_DEBIAN_MIRROR=""
# Optional trusted Docker Hub mirror host[/namespace], WITHOUT https:// or /library.
# Both Python and GCC are fetched via <host>/library/<image>; GCC keeps its pinned digest.
SETDRAFT_DOCKER_REGISTRY=""
# Optional HTTP(S) build download proxy. Use an address reachable from containers. Does not configure Docker's daemon.
SETDRAFT_DOWNLOAD_PROXY=""

# Optional application limits; empty = server default.
SETDRAFT_SANDBOX_IMAGE=""
SETDRAFT_TESTCASES_MAX=""
SETDRAFT_TOTAL_TIME_LIMIT_MS=""
SETDRAFT_CASE_MAX_BYTES=""
SETDRAFT_PROJECT_MAX_BYTES=""
SETDRAFT_AI_CONFIG_PATH=""
