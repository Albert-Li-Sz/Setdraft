{
	"name": "@setdraft/authoring",
	"version": "0.1.0",
	"description": "Deterministic Hydro problem validation and package generation",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./statement": {
			"types": "./src/statement.ts",
			"import": "./src/statement.ts"
		},
		"./markdown": {
			"types": "./src/markdown.ts",
			"import": "./src/markdown.ts"
		}
	},
	"bin": {
		"hydro-authoring": "./dist/cli.js"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "UNLICENSED",
	"dependencies": {
		"remark-gfm": "4.0.1",
		"remark-math": "6.0.0",
		"remark-parse": "11.0.0",
		"remark-stringify": "11.0.0",
		"unified": "11.0.5",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/mdast": "4.0.4",
		"mdast-util-from-markdown": "2.0.3",
		"micromark-util-types": "2.0.2",
		"shx": "0.4.0",
		"vitest": "4.1.11"
	}
}
