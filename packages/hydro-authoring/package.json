{
	"name": "@hydro-problem-make/authoring",
	"version": "0.1.0",
	"description": "Deterministic Hydro problem validation and package generation",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./statement": {
			"types": "./src/statement.ts",
			"import": "./src/statement.ts"
		}
	},
	"bin": {
		"hydro-authoring": "./dist/cli.js"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "UNLICENSED",
	"dependencies": {
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}
