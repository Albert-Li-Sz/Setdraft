{
	"name": "@setdraft/server",
	"version": "0.1.0",
	"description": "Local HTTP API for Setdraft",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"sandbox",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsx src/cli.ts",
		"db:migrate": "tsx src/migrate-cli.ts",
		"test": "node ../../scripts/test-server.mjs",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "UNLICENSED",
	"dependencies": {
		"@earendil-works/pi-ai": "^0.87.0",
		"@setdraft/authoring": "0.1.0",
		"@setdraft/contracts": "0.1.0",
		"pg": "8.23.0"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"vitest": "4.1.9"
	}
}
